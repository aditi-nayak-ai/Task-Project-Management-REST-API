# Copy this file to .env and fill in real values. Never commit the real .env.

# Local dev (sqlite) : sqlite:///./test.db
# Docker/Postgres     : postgresql+psycopg2://taskapp:taskapp@db:5432/taskapp
DATABASE_URL=postgresql+psycopg2://taskapp:taskapp@db:5432/taskapp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters (enforced by app/core/config.py).
SECRET_KEY=replace-with-a-generated-random-secret-at-least-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of allowed browser origins, e.g.:
# CORS_ORIGINS=https://your-dashboard.streamlit.app,http://localhost:8501
CORS_ORIGINS=http://localhost:8501

ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: set both to auto-seed a first admin account on startup
# (see app/db/seed.py). Leave unset to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to "false" in any multi-worker/multi-replica deployment and run
# `alembic upgrade head` as a separate release-phase step instead.
RUN_MIGRATIONS_ON_STARTUP=true
